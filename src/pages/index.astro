---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games
    .filter((game) => game.category !== null)
    .map((game) => [game.category!.id, game.category!.name]),
)].sort((a, b) => a[1].localeCompare(b[1]));
const publishers = [...new Map(
  games
    .filter((game) => game.publisher !== null)
    .map((game) => [game.publisher!.id, game.publisher!.name]),
)].sort((a, b) => a[1].localeCompare(b[1]));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
            <fieldset class="mb-5">
              <legend class="mb-3 text-sm font-semibold text-slate-200">Filter by category</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map(([id, name]) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-300 transition-colors hover:bg-slate-700 focus-within:ring-2 focus-within:ring-blue-500">
                    <input
                      type="checkbox"
                      name="category"
                      value={id}
                      class="h-4 w-4 accent-blue-500"
                      data-testid={`category-filter-${id}`}
                    />
                    <span>{name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="flex flex-wrap items-end gap-4">
              <label class="flex min-w-56 flex-col gap-2 text-sm font-semibold text-slate-200" for="publisher-filter">
                <span>Filter by publisher</span>
                <select
                  id="publisher-filter"
                  name="publisher"
                  class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 font-normal text-slate-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map(([id, name]) => <option value={id}>{name}</option>)}
                </select>
              </label>
              <button
                type="reset"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="reset-filters"
              >
                Clear filters
              </button>
            </div>
          </form>

          <p class="mb-4 text-sm text-slate-400" aria-live="polite" data-testid="filter-count">
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="no-filter-results">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');
  const count = document.querySelector<HTMLElement>('[data-testid="filter-count"]');

  if (!filterForm) {
    throw new Error('Game filter form is missing');
  }

  const applyFilters = () => {
    const selectedCategories = new Set(
      [...filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')].map((input) => input.value),
    );
    const publisher = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches = publisher === '' || card.dataset.publisherId === publisher;
      const visible = categoryMatches && publisherMatches;
      card.classList.toggle('hidden', !visible);
      visibleCount += visible ? 1 : 0;
    });

    grid?.classList.toggle('hidden', visibleCount === 0);
    emptyState?.classList.toggle('hidden', visibleCount !== 0);
    if (count) {
      count.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    }
  };

  filterForm?.addEventListener('change', applyFilters);
  filterForm?.addEventListener('reset', () => {
    requestAnimationFrame(applyFilters);
  });
</script>
